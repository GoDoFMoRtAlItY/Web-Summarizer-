{
    "manifest_version": 3,
    "name" : "Web Summariser",
    "version": "Mark 1",

    "permissions":["scripting","activeTab","storage"],
    "action":{
        "default_popup":"popup.html",
        "default_icon":"icon.png"
    },
    "content_script":[
        {
            "matches":["<all_urls>"],
            "js":["content.js"]
        }
    ],
    "background":{
        "service_worker":"background.js"
    },
    "options_html":"options.html",
    "host_permissions":["<all_urls>"]
}